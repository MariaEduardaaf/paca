---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Dashboard from "../components/screens/Dashboard.astro";
import Transactions from "../components/screens/Transactions.astro";
import Budget from "../components/screens/Budget.astro";
import { SIGNUP_URL, APP_URL, BLOG_URL, APP_LOCALES, CURRENCY_COUNT } from "../consts";

/*
 * PERGUNTAS — a seção que substituiu os dez depoimentos inventados.
 *
 * `a` é a resposta em texto puro: é ela que vai para o FAQPage do JSON-LD.
 * `html` só existe quando a resposta visível precisa de um link, e tem de dizer
 * EXATAMENTE a mesma coisa — dado estruturado diferente do que está na tela é
 * marcação falsa.
 *
 * VERBATIM POR CONTRATO: estas perguntas e respostas alimentam o JSON-LD e
 * foram verificadas frase a frase contra o código. Redesenhos mexem no CSS
 * delas, nunca no texto.
 *
 * Cada resposta aponta para um arquivo do repositório:
 *   lojas     → APP_STORE_URL/PLAY_STORE_URL vazios (apps/blog/src/consts.ts),
 *               submissão é o item #21 do TODO.md, aberto
 *   preço     → RevenueCat é item #7/#8 do TODO.md, aberto; o cadastro pede
 *               e-mail, senha e nome (apps/web/src/pages/AuthPage.tsx)
 *   convite   → supabase/functions/generate-invite + validations/couple.ts
 *               (padrão PACA-…) + i18n/pt.ts (onboarding.*)
 *   banco     → não há integração bancária em lugar nenhum do repositório;
 *               entrada de dados é scan-receipt / scan-statement / manual
 *   sozinho   → FinanceScope "personal" (shared/src/types/transaction.ts,
 *               migration 00015)
 *   dados     → políticas RLS por couple_id (migration 00001 em diante)
 *   apagar    → supabase/functions/delete-account + ProfilePage.tsx
 */
const faq = [
  {
    q: "Tem app para iPhone e Android?",
    a: "Ainda não nas lojas. Hoje o Paca é um app web: você abre app.pacafinance.com.br no navegador — do computador ou do celular — e usa por lá, sem instalar nada.",
    html: 'Ainda não nas lojas. Hoje o Paca é um app web: você abre <a href="https://app.pacafinance.com.br">app.pacafinance.com.br</a> no navegador — do computador ou do celular — e usa por lá, sem instalar nada.',
  },
  {
    q: "Quanto custa?",
    a: "Hoje é grátis. A cobrança ainda não foi ligada, então não existe plano pago e o cadastro não pede cartão: e-mail, senha e o nome que vai aparecer para a outra pessoa. O único limite é a leitura de recibo por IA: são 10 por mês para o casal, e no momento não há como aumentar esse número. Digitar transação à mão não tem limite.",
  },
  {
    q: "Como as duas pessoas ficam na mesma conta?",
    a: "Uma das duas cria o casal e o app gera um código no formato PACA-K7RMX3PBQ4. Você manda o código para a outra pessoa, ela digita na tela de início e pronto: as duas passam a ver as mesmas transações, o mesmo orçamento e as mesmas contas do mês. Um casal tem no máximo duas pessoas.",
    html: 'Uma das duas cria o casal e o app gera um código no formato <code>PACA-K7RMX3PBQ4</code>. Você manda o código para a outra pessoa, ela digita na tela de início e pronto: as duas passam a ver as mesmas transações, o mesmo orçamento e as mesmas contas do mês. Um casal tem no máximo duas pessoas.',
  },
  {
    q: "Preciso conectar o banco?",
    a: "Não, e nem dá. O Paca não pede senha de banco e não se conecta a nenhuma instituição. As transações entram por vocês: digitadas, por foto do recibo ou por print do extrato — nesses dois casos a IA lê a imagem e preenche os campos.",
  },
  {
    q: "Dá para começar sozinho, antes da outra pessoa entrar?",
    a: "Dá. Você cria o casal e usa normalmente; quando a outra pessoa entrar com o código, ela passa a ver o histórico que já estava lá. Também existe escopo pessoal, para o gasto que é só seu e não entra na conta do casal.",
  },
  {
    q: "Meus dados ficam separados dos de outros casais?",
    a: "Ficam, e a separação é feita no banco de dados, não só na tela: cada tabela tem política de acesso por linha amarrada ao casal de quem está pedindo o dado. Uma consulta pelo dado de outro casal não retorna nada.",
  },
  {
    q: "Como apago minha conta?",
    a: "Pelo próprio app, na tela de Perfil. Não precisa pedir por e-mail nem esperar resposta de ninguém.",
  },
];

/*
 * O CÓDIGO GIGANTE — a assinatura da página. É o MESMO código de exemplo da
 * resposta do FAQ (PACA-K7RMX3PBQ4), célula a célula, para a faixa tipográfica
 * da seção "Como funciona". aria-hidden: o passo 2 logo abaixo já diz o código
 * em texto; um leitor de tela soletrando 15 células seria ruído duplicado.
 */
const codeCells = [
  { ch: "PACA-", cls: "prefix" },
  ...["K", "7", "R", "M", "X", "3", "P", "B", "Q", "4"].map((ch) => ({ ch, cls: "" })),
];

const title = "Paca Finance — finanças do casal, sempre sincronizadas";
---

<BaseLayout title={title} faq={faq.map(({ q, a }) => ({ q, a }))}>
  <nav class="nav" aria-label="Principal">
    <div class="container nav-inner">
      <a class="logo" href="/">
        <img src="/logo-icon-96.png" alt="" width="30" height="30" />
        <span>paca<span class="brand-2">finance</span></span>
        <span class="sr-only">— página inicial</span>
      </a>
      <div class="nav-links">
        <a href="#recursos">Recursos</a>
        <a href="#como-funciona">Como funciona</a>
        <a href="#perguntas">Perguntas</a>
        <a href={BLOG_URL}>Blog</a>
        <a class="nav-cta" href={SIGNUP_URL}>Criar conta grátis</a>
      </div>
    </div>
  </nav>

  <main id="conteudo">
    <!-- ─────────────────────────── hero ─────────────────────────── -->
    <section class="hero">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-content hero-intro">
            {/* O selo verificável de sempre: o app web responde no endereço
                próprio e não há cobrança ligada. Nada de contagem ao vivo. */}
            <p class="hero-eyebrow">
              <span class="pair" aria-hidden="true"><i></i><i></i></span>
              O app web já está no ar — grátis para começar
            </p>

            {/* Derivado da frase já verificada "tudo o que importa quando o
                dinheiro é dos dois": mesma substância, forma de manchete. */}
            <h1 class="display">
              O dinheiro é dos dois. <span class="accent-word">Os números também.</span>
            </h1>

            <p class="lead">
              Controlem receitas, despesas e orçamento juntos, em tempo real. Sem planilha, sem
              briga no fim do mês.
            </p>

            <div class="hero-ctas">
              <a class="btn btn-primary btn-lg" href={SIGNUP_URL}>
                Criar conta grátis
                <Icon name="arrow-right" size="18" stroke={2.5} />
              </a>
              <a class="btn btn-ghost btn-lg" href="#como-funciona">Ver como funciona</a>
            </div>

            <ul class="hero-meta">
              <li><Icon name="globe" size="16" />Abre no navegador, nada para instalar</li>
              <li><Icon name="check" size="16" />Sem cartão no cadastro</li>
            </ul>
          </div>

          {/*
            A PROVA: o produto é um app web, então aparece num NAVEGADOR — não
            num iPhone de vitrine (a página já teve botão de loja falso; a
            imagem não repete o erro). O mesmo saldo no computador e no celular:
            duas pessoas, dois aparelhos, um número. Dados de exemplo, como o
            rótulo da vitrine diz.
          */}
          <div class="hero-proof" aria-hidden="true">
            <div class="browser">
              <div class="browser-bar">
                <div class="browser-dots"><span></span><span></span><span></span></div>
                <div class="browser-url">app.pacafinance.com.br</div>
              </div>
              <div class="browser-body">
                <div class="browser-greet">
                  <div>
                    <div class="g1">Boa tarde</div>
                    <div class="g2">Lucas &amp; Marina</div>
                  </div>
                  <div class="avatars">
                    <span class="av-l">L</span>
                    <span class="av-m">M</span>
                  </div>
                </div>

                <div class="balance-card">
                  <div class="balance-label">Saldo do Casal · maio</div>
                  <div class="balance-value">R$ 8.420,50</div>
                  <div class="balance-foot">
                    <span>Receitas R$ 12.700</span>
                    <span>Despesas R$ 4.279</span>
                  </div>
                </div>

                <div class="browser-rows">
                  <div class="browser-row">
                    <span class="who av-l">L</span>
                    <span class="name">Salário</span>
                    <span class="cat">Hoje</span>
                    <span class="amt pos">+ R$ 6.500,00</span>
                  </div>
                  <div class="browser-row">
                    <span class="who av-m">M</span>
                    <span class="name">Mercado Extra <span class="tag-ia">IA</span></span>
                    <span class="cat">Alimentação</span>
                    <span class="amt neg">− R$ 287,50</span>
                  </div>
                  {/* Duas linhas bastam: uma terceira ficava meio coberta pelo
                      celularzinho e o resto parecia bug de render, não
                      sobreposição intencional. */}
                </div>
              </div>
            </div>

            <div class="mini-phone">
              <div class="mini-phone-screen">
                <div class="mini-url">app.pacafinance.com.br</div>
                <div class="mini-body">
                  <div class="mini-label">Saldo do Casal</div>
                  <div class="mini-value">R$ 8.420,50</div>
                  <div class="mini-row">
                    <span>Mercado Extra</span>
                    <span class="amt">− R$ 287,50</span>
                  </div>
                </div>
              </div>
            </div>

            <p class="proof-caption">
              o mesmo saldo, no navegador do computador e no do celular · dados de exemplo
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ────────────── recursos: linhas de livro-caixa ────────────── -->
    <section id="recursos" style="padding-top:0">
      <div class="container">
        <div class="section-head reveal">
          <span class="mono-label"
            ><span class="pair" aria-hidden="true"><i></i><i></i></span>Recursos</span
          >
          <h2 class="h2">Tudo o que importa quando o dinheiro <span class="accent-word">é dos dois.</span></h2>
          <p class="lead">
            Feito para casais que querem clareza, não confusão. Cada centavo, em comum acordo.
          </p>
        </div>

        <div class="ledger">
          <div class="ledger-row reveal">
            <span class="mono-label">Sincronia</span>
            <div>
              <h3>Sincronia em tempo real</h3>
              <p>
                Quando uma pessoa lança uma despesa, a outra vê sem recarregar a página. O saldo e
                o orçamento do mês se atualizam junto, nos dois aparelhos.
              </p>
            </div>
            <div class="sync-pair" aria-hidden="true">
              <div class="sync-card">
                <span class="who av-m">M</span>
                <span>
                  <span class="t1">Marina lançou</span>
                  <span class="t2" style="display:block">Mercado Extra</span>
                </span>
                <span class="amt">− R$ 287,50</span>
              </div>
              <div class="sync-link">apareceu para os dois na hora</div>
              <div class="sync-card">
                <span class="who av-l">L</span>
                <span>
                  <span class="t1">Na tela do Lucas</span>
                  <span class="t2" style="display:block">Mercado Extra</span>
                </span>
                <span class="amt">− R$ 287,50</span>
              </div>
            </div>
          </div>

          <div class="ledger-row reveal">
            <span class="mono-label">Recibo por IA</span>
            <div>
              <h3>Leitor de recibo com IA</h3>
              <p>
                Tire foto do recibo ou mande o print do extrato. A IA devolve estabelecimento,
                categoria, valor e data preenchidos — vocês só conferem e salvam.
              </p>
            </div>
            <div aria-hidden="true">
              <div class="receipt-scrap">
                <div class="rr"><span>MERCADO EXTRA</span><span>15 MAI</span></div>
                <div class="rr total"><span>TOTAL</span><span>R$ 287,50</span></div>
              </div>
              <div class="receipt-result">
                <Icon name="sparkles" size="16" />
                <span class="mono">Alimentação · R$ 287,50</span>
              </div>
            </div>
          </div>

          <div class="ledger-row reveal">
            <span class="mono-label">Orçamento</span>
            <div>
              <h3>Orçamento do casal</h3>
              <p>
                Definam juntos o limite de cada categoria. Os dois veem quanto já foi usado no
                mês, categoria por categoria, no mesmo número.
              </p>
            </div>
            <div class="budget-mini" aria-hidden="true">
              <div class="bm-label"><span>Alimentação</span><span class="pct">79%</span></div>
              <div class="bm-bar"><i style="width:79%"></i></div>
              <div class="bm-label"><span>Moradia</span><span class="pct">90%</span></div>
              <div class="bm-bar"><i style="width:90%"></i></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ────────── A ASSINATURA: o ritual do código do casal ────────── -->
    <section id="como-funciona" class="sec-tinta">
      <div class="container">
        <div class="section-head">
          <span class="mono-label"
            ><span class="pair" aria-hidden="true"><i></i><i></i></span>Como funciona</span
          >
          <h2 class="h2">Três passos, <span style="color:var(--rosa)">e um código.</span></h2>
          <p class="lead">
            Não tem convite por e-mail nem espera de aprovação: quem cria o casal recebe um código
            e manda para a outra pessoa do jeito que quiser.
          </p>
        </div>

        {/* O objeto mais próprio deste produto, em tipografia gigante. É o
            mesmo código de exemplo do FAQ; as células digitam ao entrar na
            tela (e ficam estáticas sem JS ou com movimento reduzido). */}
        <div class="code-strip reveal" aria-hidden="true">
          {codeCells.map((cell, index) => (
            <span class={`code-cell ${cell.cls}`} style={`--i:${index}`}>{cell.ch}</span>
          ))}
        </div>
        <p class="code-note">
          um código, duas pessoas — é ele que liga as duas contas
        </p>

        <div class="steps">
          <article class="step">
            <span class="step-num" aria-hidden="true">1</span>
            <h3>Crie sua conta</h3>
            <p>
              E-mail, senha e o nome que vai aparecer para a outra pessoa. Não pede cartão nem
              dado de banco.
            </p>
          </article>

          <article class="step">
            <span class="step-num" aria-hidden="true">2</span>
            <h3>Gere o código do casal</h3>
            <p>
              O app cria um código no formato <code>PACA-K7RMX3PBQ4</code>. Mande por mensagem,
              leia em voz alta, escreva num papel — tanto faz.
            </p>
          </article>

          <article class="step">
            <span class="step-num" aria-hidden="true">3</span>
            <h3>A outra pessoa entra com ele</h3>
            <p>
              A partir daí vocês veem as mesmas transações, o mesmo orçamento e as mesmas contas
              do mês. Um casal tem no máximo duas pessoas.
            </p>
          </article>
        </div>

        <div class="ritual-cta">
          <a class="btn btn-primary" href={SIGNUP_URL}>
            Criar conta grátis
            <Icon name="arrow-right" size="18" stroke={2.5} />
          </a>
          <span class="aside">Sem cartão. O código sai na hora.</span>
        </div>
      </div>
    </section>

    <!-- ─────────────────── o que dá para conferir ─────────────────── -->
    <section>
      <div class="container">
        <div class="section-head reveal">
          <span class="mono-label"
            ><span class="pair" aria-hidden="true"><i></i><i></i></span>Hoje</span
          >
          <h2 class="h2">Produto novo, <span class="accent-word">conta aberta.</span></h2>
          {/*
            Substitui o bloco de contadores animados ("2.300+ casais ativos",
            "4.9 na App Store"). Nenhum daqueles números existia. Em vez de
            trocar por outros inventados, a página diz que não tem contagem — e
            mostra o que dá para conferir abrindo o app.
          */}
          <p class="lead">
            O Paca é novo: o app web acabou de entrar no ar no endereço próprio. Não temos
            contagem de usuários para mostrar, então mostramos o que dá para conferir.
          </p>
        </div>

        <div class="facts reveal">
          <div class="fact">
            <div class="fact-num">4</div>
            <div class="fact-label">idiomas</div>
            <p class="fact-sub">{APP_LOCALES.join(" · ")}</p>
          </div>
          <div class="fact">
            <div class="fact-num">{CURRENCY_COUNT}</div>
            <div class="fact-label">moedas</div>
            <p class="fact-sub">Convertidas para a moeda principal do casal pela cotação do dia</p>
          </div>
          <div class="fact">
            <div class="fact-num">1</div>
            <div class="fact-label">código</div>
            <p class="fact-sub">É o que liga as duas contas. Sem convite por e-mail, sem espera</p>
          </div>
          <div class="fact">
            <div class="fact-num">R$ 0</div>
            <div class="fact-label">para começar</div>
            <p class="fact-sub">A cobrança ainda não foi ligada e o cadastro não pede cartão</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────────────── vitrine do app ─────────────────────── -->
    <section id="o-app" style="padding-top:0;overflow:hidden">
      <div class="container">
        <div class="section-head reveal">
          <span class="mono-label"
            ><span class="pair" aria-hidden="true"><i></i><i></i></span>O app</span
          >
          <h2 class="h2">Bonito de usar, <span class="accent-word">todos os dias.</span></h2>
          <p class="lead">Pensado para o seu bolso e o do seu par. Sem ruído, sem números soltos.</p>
        </div>

        <div class="showcase-track reveal">
          <div class="showcase-item">
            <PhoneFrame
              label="Tela de transações do Paca Finance: busca, filtros por pessoa e a lista do mês agrupada por dia"
            >
              <Transactions />
            </PhoneFrame>
            <p class="showcase-caption">Transações</p>
          </div>

          <div class="showcase-item" data-featured>
            <PhoneFrame label="Tela de início do Paca Finance: saldo do casal, atalhos e as últimas transações">
              <Dashboard />
            </PhoneFrame>
            <p class="showcase-caption">Início</p>
          </div>

          <div class="showcase-item">
            <PhoneFrame
              label="Tela de orçamento do Paca Finance: anel com a porcentagem usada no mês e o gasto de cada categoria"
            >
              <Budget />
            </PhoneFrame>
            <p class="showcase-caption">Orçamento</p>
          </div>
        </div>

        {/* Rótulo explícito: as telas são desenho fiel da interface, mas nomes
            e valores são figurantes. */}
        <p class="showcase-note">Telas do app web, com dados de exemplo.</p>

        {/* A ressalva de loja no corpo da seção, não em letra miúda — é a
            informação que mais muda a expectativa de quem chega. */}
        <p class="store-caveat">
          Os aplicativos de iPhone e Android ainda não foram publicados nas lojas. Por enquanto o
          Paca é o app web, e ele abre normalmente no navegador do celular — no computador para
          revisar o mês com calma, no celular para lançar o gasto na hora. É a mesma conta e os
          mesmos dados nos dois.
        </p>
      </div>
    </section>

    <!-- ─────────────────────── antes e depois ─────────────────────── -->
    <section style="padding-top:0">
      <div class="container">
        <div class="section-head reveal">
          <span class="mono-label"
            ><span class="pair" aria-hidden="true"><i></i><i></i></span>Antes e depois</span
          >
          <h2 class="h2">A mesma vida, <span class="accent-word">muito mais leve.</span></h2>
        </div>

        <div class="ba-grid reveal">
          <div class="ba-col before">
            <span class="ba-tag">Antes do Paca</span>
            <h3>Planilhas, prints e discussão no fim do mês.</h3>
            <ul class="ba-list">
              {
                [
                  "Planilha que ninguém atualiza",
                  "Prints de extrato perdidos no WhatsApp",
                  "“Você não me avisou desse gasto”",
                  "Orçamento sem visibilidade",
                  "Recibos amassados na carteira",
                ].map((item) => (
                  <li class="ba-row">
                    <span class="icon-wrap">
                      <Icon name="x" size="13" stroke={2.6} />
                    </span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="ba-col after">
            <span class="ba-tag">Com o Paca</span>
            <h3>Tudo no mesmo lugar, para as duas pessoas.</h3>
            {/* Cada linha desta coluna é uma função que existe no código.
                "Notificações para os dois" segue fora: o agendador de avisos
                ainda não está configurado (itens #9/#10 do TODO.md). */}
            <ul class="ba-list">
              {
                [
                  "Receitas e despesas aparecem para os dois na hora",
                  "Foto do recibo vira transação preenchida",
                  "Orçamento por categoria, o mesmo para as duas pessoas",
                  "Contas do mês numa lista, com o que já foi pago marcado",
                  "Busca e filtro por pessoa, categoria e mês",
                ].map((item) => (
                  <li class="ba-row">
                    <span class="icon-wrap">
                      <Icon name="check" size="13" stroke={2.6} />
                    </span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────────── idiomas e moedas ─────────────────── -->
    <section style="padding-top:0">
      <div class="container">
        <div class="intl-grid reveal">
          <div class="intl-col">
            <span class="mono-label"
              ><span class="pair" aria-hidden="true"><i></i><i></i></span>Idiomas</span
            >
            <h3>Para casais que <span class="accent-word">não moram no mesmo idioma.</span></h3>
            {/* São quatro — packages/shared/src/i18n tem en, pt, ru e uk, e
                mais nada. A versão com "8 idiomas" era inventada e já saiu. */}
            <p>
              São quatro, e cada pessoa escolhe o seu: o idioma fica no perfil, não na conta do
              casal. Um pode usar o app em português e a outra em ucraniano, vendo os mesmos
              números.
            </p>
            <ul class="intl-langs">
              {
                APP_LOCALES.map((locale) => (
                  <li class="lang-chip">
                    <span class="dot" aria-hidden="true" />
                    {locale}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="intl-col">
            <span class="mono-label"
              ><span class="pair" aria-hidden="true"><i></i><i></i></span>Multimoeda</span
            >
            {/*
              ATENÇÃO AO VERBO: quem lê a moeda estrangeira é a IA, a partir do
              recibo (supabase/functions/scan-receipt). Digitar à mão grava
              sempre a moeda principal (NewTransactionPage.tsx:84). A frase
              descreve o que a tela faz hoje, não o roadmap.
            */}
            <h3>Recibo em outra moeda, <span class="accent-word">conta na sua.</span></h3>
            <p>
              Vocês escolhem a moeda principal do casal entre {CURRENCY_COUNT}. Fotografou um
              recibo em euro ou em iene? A IA lê o valor na moeda do papel e converte para a de
              vocês, pela cotação do dia — a conta do mês fecha num número só.
            </p>
            {/* As três linhas ilustram a conversão, não pessoas — sem valor
                convertido, que seria inventar cotação. */}
            <div class="currency-stack" aria-hidden="true">
              <div class="currency-row">
                <div class="who">
                  <div class="name">Salário</div>
                  <div class="sub">Recebido no exterior</div>
                </div>
                <div class="amt">
                  <span>€ 4.200,00</span>
                  <span class="fx-chip">EUR → BRL</span>
                </div>
              </div>
              <div class="currency-row">
                <div class="who">
                  <div class="name">Freelance</div>
                  <div class="sub">Cliente fora do país</div>
                </div>
                <div class="amt">
                  <span>$ 1.800,00</span>
                  <span class="fx-chip">USD → BRL</span>
                </div>
              </div>
              <div class="currency-row">
                <div class="who">
                  <div class="name">Viagem</div>
                  <div class="sub">Gastos do dia a dia</div>
                </div>
                <div class="amt">
                  <span>¥ 84.500</span>
                  <span class="fx-chip">JPY → BRL</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────────────── perguntas ─────────────────────── -->
    <section id="perguntas" style="padding-top:0">
      <div class="container">
        <div class="section-head reveal">
          <span class="mono-label"
            ><span class="pair" aria-hidden="true"><i></i><i></i></span>Antes de começar</span
          >
          <h2 class="h2">As perguntas que <span class="accent-word">todo casal faz.</span></h2>
          <p class="lead">
            Respostas curtas e sem letra miúda — inclusive as que não são a resposta que a gente
            gostaria de dar ainda.
          </p>
        </div>

        <div class="faq-list reveal">
          {
            faq.map((item, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{item.q}</summary>
                <div class="faq-answer">
                  <p set:html={item.html ?? item.a} />
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ─────────────────────── chamada final ─────────────────────── -->
    <section class="final">
      <div class="container">
        <span class="mono-label"
          ><span class="pair" aria-hidden="true"><i></i><i></i></span>Paca Finance</span
        >
        <h2>Prontos para organizar as finanças juntos?</h2>
        {/* Produto novo não tem multidão para mostrar — tem o convite de ser
            dos primeiros, que é verdade e vende igual. */}
        <p class="lead">
          Criar a conta leva um minuto e não pede cartão. O convite para a outra pessoa é um
          código — vocês podem estar vendo os mesmos números hoje.
        </p>

        <div class="final-cta-row">
          <a class="btn btn-primary btn-lg" href={SIGNUP_URL}>
            Criar conta grátis
            <Icon name="arrow-right" size="18" stroke={2.5} />
          </a>
          <a class="btn btn-ghost btn-lg" href={APP_URL}>Já tenho conta</a>
        </div>

        <p class="final-meta">Abre no navegador, no computador e no celular.</p>
      </div>

      {/* O mascote como carimbo de canto — o mesmo papel que ele tem nas
          capas do blog. Fora do .container de propósito: o canto é o da
          SEÇÃO rosa, não o da coluna de texto. Decorativo: alt vazio. */}
      <img class="final-mascot" src="/paca-mascote.png" alt="" width="210" height="210" loading="lazy" />
    </section>
  </main>

  <Footer />
</BaseLayout>
