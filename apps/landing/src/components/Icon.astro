---
/*
 * Ícones em SVG inline, desenhados à mão no mesmo traço (24x24, stroke 2,
 * pontas arredondadas). Inline e não sprite/arquivo porque são poucos e
 * pequenos: um <img> ou um sprite externo custaria uma requisição a mais para
 * economizar bytes que não existem.
 *
 * `aria-hidden` em todos: nenhum ícone desta página carrega informação que o
 * texto ao lado já não diga.
 */
interface Props {
  name:
    | "arrow-right"
    | "arrow-up"
    | "arrow-down"
    | "bell"
    | "camera"
    | "car"
    | "cart"
    | "check"
    | "globe"
    | "home"
    | "laptop"
    | "phone"
    | "pie"
    | "plus"
    | "receipt"
    | "refresh"
    | "search"
    | "sparkles"
    | "users"
    | "x";
  size?: number | string;
  stroke?: number;
  class?: string;
}
const { name, size = 24, stroke = 2, class: className = "" } = Astro.props;

const paths: Record<Props["name"], string> = {
  "arrow-right": "M5 12h14M13 5l7 7-7 7",
  "arrow-up": "M12 19V5M5 12l7-7 7 7",
  "arrow-down": "M12 5v14M19 12l-7 7-7-7",
  bell: "M18 16H6v-5a6 6 0 1 1 12 0v5zM10 20a2 2 0 0 0 4 0",
  camera: "M3 8.5A1.5 1.5 0 0 1 4.5 7h2L8 5h8l1.5 2h2A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5v-9zM12 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z",
  car: "M5 17h14M6.5 17a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zM20.5 17a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zM4 13l1.6-4.4A2 2 0 0 1 7.5 7h9a2 2 0 0 1 1.9 1.6L20 13v4H4v-4z",
  cart: "M3 4h2l2.4 10.4A2 2 0 0 0 9.3 16h7.6a2 2 0 0 0 2-1.6L20 7H6M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0zM19 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0z",
  check: "M4.5 12.5l5 5 10-11",
  globe: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3.5 9h17M3.5 15h17M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18",
  home: "M4 10.5L12 4l8 6.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1v-9.5z",
  laptop: "M5 5h14v10H5V5zM2.5 19h19M3.5 15h17",
  phone: "M7.5 2.5h9A1.5 1.5 0 0 1 18 4v16a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 20V4a1.5 1.5 0 0 1 1.5-1.5zM10.5 18.5h3",
  pie: "M12 3a9 9 0 1 0 9 9h-9V3z",
  plus: "M12 5v14M5 12h14",
  receipt: "M6 2.5h12v19l-2.4-1.6-2.4 1.6-2.4-1.6L8.4 21.5 6 19.9V2.5zM9.5 8h5M9.5 12h5",
  refresh: "M20 11a8 8 0 1 0-.6 4M20 5v6h-6",
  search: "M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4",
  sparkles: "M12 3l1.7 4.8L18.5 9.5 13.7 11.2 12 16l-1.7-4.8L5.5 9.5l4.8-1.7L12 3zM18.5 15l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2z",
  users: "M16 20v-1.5A3.5 3.5 0 0 0 12.5 15h-5A3.5 3.5 0 0 0 4 18.5V20M10 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM20 20v-1.5a3.5 3.5 0 0 0-2.6-3.4M15.5 5.2a3.5 3.5 0 0 1 0 6.6",
  x: "M6 6l12 12M18 6L6 18",
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={paths[name]}></path></svg
>
