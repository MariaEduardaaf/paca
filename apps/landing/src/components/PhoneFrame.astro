---
/*
 * Moldura do aparelho. Só a casca: a barra com o endereço e o vidro. A tela
 * entra pelo <slot>.
 *
 * O desenho original trazia isto como um componente React com ~400 linhas de
 * estilo em linha. Aqui a moldura inteira depende de UMA variável CSS
 * (`--phone-w`, ver .phone em global.css) — mudar o tamanho é mudar um número,
 * e o conteúdo escala junto porque a tela usa `em`.
 *
 * SEM barra de status nativa (9:41, sinal, bateria, entalhe): o produto é um
 * app WEB aberto no navegador do celular, e a página inteira argumenta isso —
 * o hero já mostra um navegador em vez de um iPhone de vitrine. Uma status bar
 * de iOS aqui leria como screenshot de app de loja, que é exatamente a mentira
 * que já saiu desta página. No lugar, o mesmo tratamento do .mini-phone do
 * hero: a barrinha com o endereço app.pacafinance.com.br.
 *
 * A barra é decorativa (o endereço já está escrito na página várias vezes),
 * então sai da árvore de acessibilidade com o resto da moldura.
 */
interface Props {
  /** Rótulo da tela para leitor de tela. */
  label: string;
  class?: string;
}
const { label, class: className = "" } = Astro.props;
---

<div class:list={["phone", className]} role="img" aria-label={label}>
  <div class="phone-url" aria-hidden="true">app.pacafinance.com.br</div>

  <div class="phone-screen" aria-hidden="true">
    <slot />
  </div>

  <div class="phone-glare" aria-hidden="true"></div>
</div>
