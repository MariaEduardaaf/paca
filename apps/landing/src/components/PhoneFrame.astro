---
/*
 * Moldura do aparelho. Só a casca: entalhe, barra de status e o brilho do
 * vidro. A tela entra pelo <slot>.
 *
 * O desenho original trazia isto como um componente React com ~400 linhas de
 * estilo em linha. Aqui a moldura inteira depende de UMA variável CSS
 * (`--phone-w`, ver .phone em global.css) — mudar o tamanho é mudar um número,
 * e o conteúdo escala junto porque a tela usa `em`.
 *
 * A barra de status é decorativa: 9:41 é a hora de vitrine da Apple, os ícones
 * são desenho. Por isso o bloco inteiro sai da árvore de acessibilidade
 * (aria-hidden) — leitor de tela anunciando "nove e quarenta e um, sinal,
 * wi-fi, bateria" antes de cada tela seria ruído puro.
 */
interface Props {
  /** Rótulo da tela para leitor de tela. */
  label: string;
  class?: string;
}
const { label, class: className = "" } = Astro.props;
---

<div class:list={["phone", className]} role="img" aria-label={label}>
  <div class="phone-notch" aria-hidden="true"></div>

  <div class="phone-status" aria-hidden="true">
    <span>9:41</span>
    <span style="display:flex;align-items:center;gap:0.42em;">
      <svg width="1.2em" height="0.76em" viewBox="0 0 19 12" fill="#fff">
        <rect x="0" y="7.5" width="3.2" height="4.5" rx="0.7"></rect>
        <rect x="4.8" y="5" width="3.2" height="7" rx="0.7"></rect>
        <rect x="9.6" y="2.5" width="3.2" height="9.5" rx="0.7"></rect>
        <rect x="14.4" y="0" width="3.2" height="12" rx="0.7"></rect>
      </svg>
      <svg width="1.07em" height="0.76em" viewBox="0 0 17 12" fill="#fff">
        <path
          d="M8.5 3.2C10.8 3.2 12.9 4.1 14.4 5.6L15.5 4.5C13.7 2.7 11.2 1.5 8.5 1.5C5.8 1.5 3.3 2.7 1.5 4.5L2.6 5.6C4.1 4.1 6.2 3.2 8.5 3.2Z"
        ></path>
        <path
          d="M8.5 6.8C9.9 6.8 11.1 7.3 12 8.2L13.1 7.1C11.8 5.9 10.2 5.1 8.5 5.1C6.8 5.1 5.2 5.9 3.9 7.1L5 8.2C5.9 7.3 7.1 6.8 8.5 6.8Z"
        ></path>
        <circle cx="8.5" cy="10.5" r="1.5"></circle>
      </svg>
      <svg width="1.7em" height="0.82em" viewBox="0 0 27 13">
        <rect
          x="0.5"
          y="0.5"
          width="23"
          height="12"
          rx="3.5"
          stroke="#fff"
          stroke-opacity="0.35"
          fill="none"></rect>
        <rect x="2" y="2" width="20" height="9" rx="2" fill="#fff"></rect>
        <path d="M25 4.5V8.5C25.8 8.2 26.5 7.2 26.5 6.5C26.5 5.8 25.8 4.8 25 4.5Z" fill="#fff" fill-opacity="0.4"
        ></path>
      </svg>
    </span>
  </div>

  <div class="phone-screen" aria-hidden="true">
    <slot />
  </div>

  <div class="phone-glare" aria-hidden="true"></div>
</div>
