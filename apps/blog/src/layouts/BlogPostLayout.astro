---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getCollection, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import CTABox from "../components/CTABox.astro";
import Cover from "../components/Cover.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import PostCard from "../components/PostCard.astro";
import ShareBox from "../components/ShareBox.astro";
import { SITE_TITLE, SITE_URL, APP_URL } from "../consts";
import { CATEGORIES } from "../lib/categories";
import { COVER_PALETTES } from "../lib/covers";
import { ctaFor } from "../lib/ctas";
import type { BlogPost } from "../lib/posts";
import {
  extractFaq,
  formatDate,
  readingTimeMinutes,
  sortByDateDesc,
} from "../lib/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const { title, description, pubDate, updatedDate, category } = post.data;
const categoryInfo = CATEGORIES[category];
const palette = COVER_PALETTES[category];
const minutes = readingTimeMinutes(post.body);

// CTA de produto escrito para a dor deste artigo (src/lib/ctas.ts). Slug sem
// entrada devolve {} e o CTABox cai nos próprios defaults — artigo novo nunca
// fica sem CTA.
const cta = ctaFor(post.id);

// Inline "Neste artigo" TOC, only for long pieces (NerdWallet pattern).
const tocEntries = headings.filter((h) => h.depth === 2);
const showToc = tocEntries.length >= 4;

const postUrl = new URL(`/blog/${post.id}`, SITE_URL).href;
// Logo do publisher no JSON-LD: aqui vale o arquivo grande (480x480) de
// propósito — é lido pelo Google, não baixado pelo leitor. O que a página
// realmente exibe é /logo-icon-96.png. O 480 também alimenta scripts/og.mjs
// (card 1200x630); não troque nenhum dos dois pelo 96.
const logoUrl = new URL("/logo-icon-large.png", SITE_URL).href;

// Card de compartilhamento próprio do artigo, gerado por `npm run og` e
// versionado em public/og/ (scripts/og.mjs explica o porquê). Se o PNG do post
// ainda não foi gerado, cai no /og-default.png — o build nunca quebra por isso.
// (process.cwd() e não import.meta.url: no build o Astro empacota este layout
// num chunk, então import.meta.url aponta para o bundle, não para src/layouts.)
const ogPath = `/og/${post.id}.png`;
const ogImage = existsSync(join(process.cwd(), "public", "og", `${post.id}.png`))
  ? ogPath
  : "/og-default.png";

// "Leia também": same category first, padded with recent posts from others.
const allPosts = sortByDateDesc(
  await getCollection("blog", ({ data }) => !data.draft),
);
const sameCategory = allPosts.filter(
  (p) => p.id !== post.id && p.data.category === category,
);
const others = allPosts.filter(
  (p) => p.id !== post.id && p.data.category !== category,
);
const related = [...sameCategory, ...others].slice(0, 3);

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: "pt-BR",
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  author: { "@type": "Organization", name: SITE_TITLE, url: APP_URL },
  publisher: {
    "@type": "Organization",
    name: SITE_TITLE,
    logo: { "@type": "ImageObject", url: logoUrl },
  },
  image: [new URL(ogImage, SITE_URL).href],
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Início",
      item: new URL("/", SITE_URL).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog", SITE_URL).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: categoryInfo.label,
      item: new URL(`/categorias/${category}`, SITE_URL).href,
    },
    { "@type": "ListItem", position: 4, name: title, item: postUrl },
  ],
};

// FAQPage JSON-LD only when the markdown body has an H2 "Perguntas frequentes"
// with "### question" + paragraph pairs (parsed from post.body in lib/posts).
const faqItems = extractFaq(post.body);
const faqJsonLd =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }
    : null;
---

<BaseLayout title={title} description={description} type="article" ogImage={ogImage}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    {faqJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  </Fragment>

  <article
    class="mx-auto max-w-3xl px-4 py-10 sm:px-6"
    style={`--kc:${palette.kicker};--kcd:${palette.kickerDark}`}
  >
    <nav aria-label="Trilha de navegação" class="text-sm text-gray-600 dark:text-gray-400">
      <ol class="flex flex-wrap items-center gap-1">
        <li>
          <a href="/" class="rounded transition-colors hover:text-pink-700 dark:hover:text-pink-300">Início</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href="/blog" class="rounded transition-colors hover:text-pink-700 dark:hover:text-pink-300">Blog</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href={`/categorias/${category}`} class="rounded transition-colors hover:text-pink-700 dark:hover:text-pink-300">
            {categoryInfo.label}
          </a>
        </li>
      </ol>
    </nav>

    <header class="mt-6">
      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--kc)] dark:text-[color:var(--kcd)]">
        <a href={`/categorias/${category}`} class="rounded">{categoryInfo.label}</a>
      </p>

      <h1 class="mt-3 font-display text-[2.1rem] font-bold leading-[1.15] text-gray-800 sm:text-[2.6rem] dark:text-white">
        {title}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-300">{description}</p>

      <div class="mt-6 flex items-center gap-3 border-y border-gray-100 py-4 dark:border-gray-800">
        <img
          src="/logo-icon-96.png"
          alt=""
          class="h-9 w-9 rounded-full"
          width="36"
          height="36"
        />
        <p class="text-sm text-gray-600 dark:text-gray-300">
          <a href="/sobre" class="rounded font-semibold text-gray-800 hover:text-pink-700 dark:text-gray-100 dark:hover:text-pink-300">
            Equipe Paca Finance
          </a>
          <span class="block text-gray-600 sm:inline dark:text-gray-400">
            <span class="hidden sm:inline" aria-hidden="true"> · </span>
            Publicado em <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {
              updatedDate && (
                <>
                  <span aria-hidden="true"> · </span>
                  Atualizado em <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
                </>
              )
            }
            <span aria-hidden="true"> · </span>
            {minutes} min de leitura
          </span>
        </p>
      </div>

      {/* Primeira dobra, junto do título — o slot de maior valor (ESTRATEGIA §5). */}
      <AdSlot placement="first-fold" />

      <div class="mt-8 overflow-hidden rounded-2xl">
        <Cover category={category} slug={post.id} class="aspect-video w-full" />
      </div>
    </header>

    {
      showToc && (
        <nav
          aria-labelledby="toc-title"
          class="mt-8 rounded-2xl border border-gray-100 bg-gray-50 p-5 dark:border-gray-800 dark:bg-gray-800/60"
        >
          <p id="toc-title" class="text-xs font-semibold uppercase tracking-[0.12em] text-gray-600 dark:text-gray-400">
            Neste artigo
          </p>
          <ol class="mt-3 space-y-2 text-[15px]">
            {tocEntries.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="rounded text-gray-700 transition-colors hover:text-pink-700 dark:text-gray-200 dark:hover:text-pink-300"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose-paca mt-10">
      <Content />
    </div>

    {/*
      Ordem do fim do artigo, de propósito (o texto termina aqui):

      1. Compartilhar — o passo que o próprio artigo pede ("combina com a outra
         pessoa"). É um convite leve e a favor do leitor, então vem primeiro.
      2. Anúncio.
      3. Newsletter — o único pedido de e-mail da página, ANTES dos cards de
         "Leia também". Depois deles, quem ia clicar já clicou.
      4. "Leia também".
      5. CTABox (produto) — fecha a página. Fica longe da newsletter de
         propósito: os dois pedidos colados viravam um muro no fim do texto, e
         a grade de artigos entre eles dá o respiro.
    */}
    <ShareBox url={postUrl} title={title} />

    <AdSlot placement="in-content" />

    {/* `source` = slug, para saber que conteúdo converte (ESTRATEGIA §6). */}
    <NewsletterForm source={post.id} />

    {
      related.length > 0 && (
        <section aria-labelledby="relacionados" class="mt-14 border-t border-gray-100 pt-10 dark:border-gray-800">
          <h2 id="relacionados" class="font-display text-xl font-bold text-gray-800 sm:text-2xl dark:text-white">
            Leia também
          </h2>
          <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <PostCard post={p} showExcerpt={false} />
            ))}
          </div>
        </section>
      )
    }

    <CTABox {...cta} />

    <p class="mt-12 border-t border-gray-100 pt-6 text-[13px] leading-relaxed text-gray-600 dark:border-gray-800 dark:text-gray-400">
      Conteúdo editorial do blog do Paca Finance. Não é recomendação de
      investimento. Saiba como produzimos e revisamos nossos guias na
      <a href="/sobre#politica-editorial" class="rounded underline underline-offset-2 hover:text-pink-700 dark:hover:text-pink-300">política editorial</a>.
    </p>
  </article>
</BaseLayout>
