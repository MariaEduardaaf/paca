---
import { getCollection, render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import CTABox from "../components/CTABox.astro";
import PostCard from "../components/PostCard.astro";
import { SITE_TITLE, SITE_URL, APP_URL } from "../consts";
import { CATEGORIES } from "../lib/categories";
import type { BlogPost } from "../lib/posts";
import {
  extractFaq,
  formatDate,
  readingTimeMinutes,
  sortByDateDesc,
} from "../lib/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, description, pubDate, updatedDate, category, heroEmoji } =
  post.data;
const categoryInfo = CATEGORIES[category];
const minutes = readingTimeMinutes(post.body);

const postUrl = new URL(`/blog/${post.id}`, SITE_URL).href;
const logoUrl = new URL("/logo-icon-large.png", SITE_URL).href;

// Related (same category) + prev/next across all published posts.
const allPosts = sortByDateDesc(
  await getCollection("blog", ({ data }) => !data.draft),
);
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === category)
  .slice(0, 3);
const index = allPosts.findIndex((p) => p.id === post.id);
const newerPost = index > 0 ? allPosts[index - 1] : undefined;
const olderPost =
  index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : undefined;

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: "pt-BR",
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  author: { "@type": "Organization", name: SITE_TITLE, url: APP_URL },
  publisher: {
    "@type": "Organization",
    name: SITE_TITLE,
    logo: { "@type": "ImageObject", url: logoUrl },
  },
  image: [new URL("/og-default.png", SITE_URL).href],
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Início",
      item: new URL("/", SITE_URL).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog", SITE_URL).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: categoryInfo.label,
      item: new URL(`/categorias/${category}`, SITE_URL).href,
    },
    { "@type": "ListItem", position: 4, name: title, item: postUrl },
  ],
};

// FAQPage JSON-LD only when the markdown body has an H2 "Perguntas frequentes"
// with "### question" + paragraph pairs (parsed from post.body in lib/posts).
const faqItems = extractFaq(post.body);
const faqJsonLd =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }
    : null;
---

<BaseLayout title={title} description={description} type="article">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    {faqJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  </Fragment>

  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <nav aria-label="Trilha de navegação" class="text-sm text-gray-500 dark:text-gray-400">
      <ol class="flex flex-wrap items-center gap-1">
        <li>
          <a href="/" class="rounded-lg transition-colors hover:text-pink-700 dark:hover:text-pink-300">Início</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href="/blog" class="rounded-lg transition-colors hover:text-pink-700 dark:hover:text-pink-300">Blog</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href={`/categorias/${category}`} class="rounded-lg transition-colors hover:text-pink-700 dark:hover:text-pink-300">
            {categoryInfo.label}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="truncate text-gray-700 dark:text-gray-200">{title}</li>
      </ol>
    </nav>

    <header class="mt-8">
      <div
        class="flex h-44 items-center justify-center rounded-3xl bg-gradient-to-br from-pink-50 via-pink-100 to-pink-200 sm:h-52 dark:from-pink-900/50 dark:via-gray-800 dark:to-pink-900/30"
        aria-hidden="true"
      >
        <span class="text-7xl sm:text-8xl">{heroEmoji}</span>
      </div>

      <p class="mt-6">
        <a
          href={`/categorias/${category}`}
          class="inline-block rounded-full bg-pink-100 px-3 py-1 text-xs font-semibold text-pink-800 transition-colors hover:bg-pink-200 dark:bg-pink-900 dark:text-pink-200 dark:hover:bg-pink-800"
        >
          {categoryInfo.label}
        </a>
      </p>

      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-gray-900 sm:text-4xl dark:text-white">
        {title}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-300">{description}</p>

      <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true"> · </span>
        <span>{minutes} min de leitura</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true"> · </span>
              <span>
                Atualizado em <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
      </p>
    </header>

    <div class="prose-paca mt-10">
      <Content />
    </div>

    <CTABox />

    {
      related.length > 0 && (
        <section aria-labelledby="relacionados" class="mt-14">
          <h2 id="relacionados" class="font-display text-2xl font-bold text-gray-900 dark:text-white">
            Posts relacionados
          </h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </section>
      )
    }

    {
      (olderPost || newerPost) && (
        <nav aria-label="Outros posts" class="mt-14 grid gap-4 border-t border-gray-100 pt-8 sm:grid-cols-2 dark:border-gray-800">
          {olderPost ? (
            <a
              href={`/blog/${olderPost.id}`}
              class="group rounded-2xl border border-gray-100 p-4 transition-colors hover:border-pink-300 dark:border-gray-800 dark:hover:border-pink-600"
            >
              <span class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">← Post anterior</span>
              <span class="mt-1 block font-display font-semibold text-gray-900 group-hover:text-pink-700 dark:text-white dark:group-hover:text-pink-300">
                {olderPost.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {newerPost && (
            <a
              href={`/blog/${newerPost.id}`}
              class="group rounded-2xl border border-gray-100 p-4 text-right transition-colors hover:border-pink-300 dark:border-gray-800 dark:hover:border-pink-600"
            >
              <span class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Próximo post →</span>
              <span class="mt-1 block font-display font-semibold text-gray-900 group-hover:text-pink-700 dark:text-white dark:group-hover:text-pink-300">
                {newerPost.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
