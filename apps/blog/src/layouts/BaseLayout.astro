---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from "../consts";

interface Props {
  /** Page title (without the "| Paca Finance" suffix). */
  title?: string;
  description?: string;
  /** og:type — "article" on post pages. */
  type?: "website" | "article";
  /**
   * Absolute or root-relative OG image; defaults to /og-default.png.
   * NOTE: public/og-default.png is currently a copy of the app's
   * logo-full.png — an acceptable placeholder until a real 1200x630
   * OG image is produced (public/og-default.svg is a branded draft).
   */
  ogImage?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = "website",
  ogImage = "/og-default.png",
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} — Blog de finanças para casais`;

// trailingSlash: "never" — normalize the canonical the same way (root stays "/").
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;
---

<html lang="pt-BR" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_TITLE} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#FF8FB1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_TITLE} — Blog`}
      href={new URL("/rss.xml", SITE_URL).href}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="generator" content={Astro.generator} />

    {/* No-flash theme: set .dark on <html> before first paint. */}
    <script is:inline>
      (function () {
        var theme = "light";
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            theme = stored;
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            theme = "dark";
          }
        } catch (_) {
          /* storage unavailable — keep light */
        }
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-full flex-col bg-white dark:bg-gray-900">
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
