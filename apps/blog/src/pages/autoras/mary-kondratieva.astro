---
/**
 * A página da autora.
 *
 * ── POR QUE ELA EXISTE ────────────────────────────────────────────────────
 * As diretrizes de avaliação de qualidade do Google pedem duas coisas juntas:
 * assinatura onde o leitor espera, E link para uma página com o histórico de
 * quem escreve. O artigo já traz a assinatura; sem esta página, ela é só texto.
 * É também daqui que o JSON-LD do artigo tira o `url` do `"@type": "Person"`.
 *
 * ── ⚠️ O QUE NÃO PODE ENTRAR AQUI ────────────────────────────────────────
 * Credencial que não seja verdade. As mesmas diretrizes listam "descrições
 * enganosas de quem cria" como marca de conteúdo de pior qualidade, e finanças
 * é assunto sensível: inventar "planejadora certificada" custa mais caro aqui
 * do que em qualquer outro tema. O que está escrito abaixo é o que se sabe:
 * ela lê e avalia os guias antes de irem ao ar. Não escreve nem edita, e não
 * há profissão nem credencial aqui.
 *
 * A divulgação do uso de IA e o checklist de conferência moraram aqui e foram
 * para a página da Madu (autoras/madu-freire), que é quem escreve.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { AUTORAS } from "../../lib/autores";

const autora = AUTORAS.mary;

// Os artigos que ela assina, do mais novo para o mais antigo. Enquanto não
// houver nenhum, a seção some: lista vazia com título é pior que ausência.
const artigos = (await getCollection("blog", ({ data }) => !data.draft && data.reviewer === "mary"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={autora.nome}
  description={`${autora.resumo}`}
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs font-bold tracking-widest text-pink-700 uppercase dark:text-pink-300">
      Avaliadora
    </p>
    <h1 class="mt-2 font-display text-3xl font-bold text-gray-900 sm:text-4xl dark:text-white">
      {autora.nome}
    </h1>
    <p class="mt-3 text-lg leading-relaxed text-gray-600 dark:text-gray-300">
      {autora.resumo}
    </p>

    <div class="prose-paca mt-8">
      <h2 id="o-que-ela-faz">O que ela faz</h2>
      <p>
        A Mary lê cada guia como leitora e aponta o que ficou confuso ou pouco
        convincente antes de publicar. Quem escreve os textos é a
        <a href="/autoras/madu-freire">Madu Freire</a>; como os artigos são
        feitos e o que é conferido antes de irem ao ar está na página dela.
      </p>
    </div>

    {
      artigos.length > 0 && (
        <section class="mt-12 border-t border-gray-100 pt-8 dark:border-gray-800">
          <h2 class="font-display text-xl font-bold text-gray-900 dark:text-white">
            Artigos que ela avaliou
          </h2>
          <ul class="mt-5 flex flex-col gap-4">
            {artigos.map((a) => (
              <li>
                <a
                  href={`/blog/${a.id}`}
                  class="rounded font-semibold text-gray-800 underline-offset-2 hover:text-pink-700 hover:underline dark:text-gray-100 dark:hover:text-pink-300"
                >
                  {a.data.title}
                </a>
                <p class="mt-1 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                  {a.data.description}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="mt-10 border-t border-gray-100 pt-6 text-sm text-gray-600 dark:border-gray-800 dark:text-gray-400">
      <a href="/blog" class="rounded underline underline-offset-2 hover:text-pink-700 dark:hover:text-pink-300">
        Ver todos os artigos
      </a>
    </p>
  </div>
</BaseLayout>
