---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import CTABox from "../components/CTABox.astro";
import Cover from "../components/Cover.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { SITE_DESCRIPTION } from "../consts";
import { formatDate, readingTimeMinutes, sortByDateDesc } from "../lib/posts";
import { CATEGORIES } from "../lib/categories";
import { COVER_PALETTES } from "../lib/covers";

const sorted = sortByDateDesc(await getCollection("blog", ({ data }) => !data.draft));
// The welcome note never takes an editorial slot — it goes last.
const posts = [
  ...sorted.filter((p) => p.id !== "bem-vindos-ao-blog-do-paca"),
  ...sorted.filter((p) => p.id === "bem-vindos-ao-blog-do-paca"),
];

// The pillar article leads the page; everything else flows chronologically.
const FEATURED_SLUG = "como-dividir-contas-casal";
const featured = posts.find((p) => p.id === FEATURED_SLUG) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured.id);
const picks = rest.slice(0, 3);
const latest = rest.slice(3);

const featuredCategory = CATEGORIES[featured.data.category];
const featuredPalette = COVER_PALETTES[featured.data.category];
const featuredMinutes = readingTimeMinutes(featured.body);
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Hub header: plain title + dek, content right below (no marketing hero) -->
    <header class="border-b border-gray-100 py-8 sm:py-10 dark:border-gray-800">
      <h1 class="font-display text-3xl font-bold text-gray-800 sm:text-4xl dark:text-white">
        Finanças para casais
      </h1>
      <p class="mt-2 max-w-2xl leading-relaxed text-gray-600 dark:text-gray-300">
        Guias práticos para organizar o dinheiro a dois: dividir contas do jeito
        justo, conversar sobre grana sem briga e realizar planos em dupla.
      </p>
    </header>

    <!-- Featured article -->
    <section aria-labelledby="destaque" class="py-10 sm:py-12">
      <h2 id="destaque" class="sr-only">Em destaque</h2>
      <article
        class="group relative grid items-center gap-6 lg:grid-cols-[7fr_5fr] lg:gap-10"
        style={`--kc:${featuredPalette.kicker};--kcd:${featuredPalette.kickerDark}`}
      >
        <div class="overflow-hidden rounded-2xl">
          <Cover
            category={featured.data.category}
            slug={featured.id}
            class="aspect-video w-full transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[color:var(--kc)] dark:text-[color:var(--kcd)]">
            <a href={`/categorias/${featured.data.category}`} class="relative z-10 rounded">
              {featuredCategory.label}
            </a>
          </p>
          <h3 class="mt-2 font-display text-2xl font-bold leading-tight text-gray-800 sm:text-[2rem] sm:leading-tight dark:text-white">
            <a
              href={`/blog/${featured.id}`}
              class="rounded transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-pink-700 dark:group-hover:text-pink-300"
            >
              {featured.data.title}
            </a>
          </h3>
          <p class="mt-3 leading-relaxed text-gray-600 dark:text-gray-300">
            {featured.data.description}
          </p>
          <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
            Equipe Paca Finance
            <span aria-hidden="true"> · </span>
            <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
            <span aria-hidden="true"> · </span>
            {featuredMinutes} min de leitura
          </p>
        </div>
      </article>
    </section>

    <!-- Editor's picks -->
    <section aria-label="Destaques recentes" class="border-t border-gray-100 py-10 dark:border-gray-800">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {picks.map((post) => <PostCard post={post} headingLevel="h2" />)}
      </div>
    </section>

    <!-- The one product block on the page -->
    <CTABox />

    <!-- Latest -->
    <section aria-labelledby="mais-recentes" class="py-10">
      <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-gray-100 pb-4 dark:border-gray-800">
        <h2 id="mais-recentes" class="font-display text-xl font-bold text-gray-800 sm:text-2xl dark:text-white">
          Mais recentes
        </h2>
        <a
          href="/blog"
          class="rounded text-sm font-semibold text-pink-700 transition-colors hover:text-pink-800 dark:text-pink-300 dark:hover:text-pink-200"
        >
          Ver todos os artigos →
        </a>
      </div>
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((post) => <PostCard post={post} headingLevel="h3" showExcerpt={false} />)}
      </div>
    </section>

    <!-- Uma única captura na home, longe do CTABox para não disputar com ele -->
    <NewsletterForm source="home" class="mb-14" />
  </div>
</BaseLayout>
