---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { APP_URL, SITE_DESCRIPTION } from "../consts";
import { sortByDateDesc } from "../lib/posts";

const posts = sortByDateDesc(
  await getCollection("blog", ({ data }) => !data.draft),
).slice(0, 6);

const features = [
  {
    emoji: "💞",
    title: "Gastos compartilhados em tempo real",
    body: "Cada compra aparece para os dois na hora. Nada de “quem pagou o quê?” no fim do mês.",
  },
  {
    emoji: "📸",
    title: "Scanner de notas com IA",
    body: "Fotografou a notinha, o Paca lê e categoriza sozinho. Registrar gasto deixa de ser tarefa chata.",
  },
  {
    emoji: "🎯",
    title: "Orçamento do casal",
    body: "Limites por categoria definidos juntos, com alertas antes de estourar — não depois.",
  },
];
---

<BaseLayout description={SITE_DESCRIPTION}>
  <section class="bg-gradient-to-b from-pink-50 to-white dark:from-gray-900 dark:to-gray-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h1 class="mx-auto max-w-3xl font-display text-4xl font-bold leading-tight text-gray-900 sm:text-5xl dark:text-white">
        Finanças a dois, sem briga e sem planilha
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        Guias práticos para casais que querem organizar o dinheiro juntos:
        dividir contas do jeito justo, conversar sobre grana sem estresse e
        realizar sonhos em dupla.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={APP_URL}
          class="rounded-xl bg-pink-primary px-6 py-3 font-semibold text-gray-900 shadow-sm transition-colors hover:bg-pink-400"
        >
          Conhecer o Paca Finance
        </a>
        <a
          href="/blog"
          class="rounded-xl border border-gray-200 bg-white px-6 py-3 font-semibold text-gray-700 transition-colors hover:border-pink-300 hover:text-pink-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:border-pink-600 dark:hover:text-pink-300"
        >
          Ler o blog
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="por-que-paca" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h2 id="por-que-paca" class="text-center font-display text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
      Por que o Paca?
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        features.map((feature) => (
          <div class="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-pink-100 to-pink-200 text-2xl dark:from-pink-900/60 dark:to-pink-800/40"
              aria-hidden="true"
            >
              {feature.emoji}
            </div>
            <h3 class="mt-4 font-display text-lg font-bold text-gray-900 dark:text-white">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">{feature.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="ultimos-posts" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 id="ultimos-posts" class="font-display text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
        Últimos posts
      </h2>
      <a href="/blog" class="rounded-lg text-sm font-semibold text-pink-700 transition-colors hover:text-pink-800 dark:text-pink-300 dark:hover:text-pink-200">
        Ver todos →
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 pt-6 sm:px-6">
    <div class="rounded-3xl bg-gradient-to-br from-pink-100 via-pink-50 to-pink-200 px-6 py-12 text-center sm:px-12 dark:from-gray-800 dark:via-gray-800 dark:to-pink-900/40 dark:ring-1 dark:ring-pink-800">
      <h2 class="font-display text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
        Prontos para cuidar do dinheiro juntos?
      </h2>
      <p class="mx-auto mt-3 max-w-xl leading-relaxed text-gray-700 dark:text-gray-200">
        O Paca Finance é grátis para começar. Criem a conta do casal e vejam
        para onde o dinheiro de vocês está indo — hoje.
      </p>
      <a
        href={APP_URL}
        class="mt-6 inline-block rounded-xl bg-pink-primary px-6 py-3 font-semibold text-gray-900 shadow-sm transition-colors hover:bg-pink-400"
      >
        Conhecer o Paca Finance
      </a>
    </div>
  </section>
</BaseLayout>
