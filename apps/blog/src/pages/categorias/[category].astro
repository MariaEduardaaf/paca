---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { CATEGORIES, CATEGORY_IDS, type CategoryId } from "../../lib/categories";
import { sortByDateDesc } from "../../lib/posts";

export async function getStaticPaths() {
  return CATEGORY_IDS.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as CategoryId;
const info = CATEGORIES[category];

const posts = sortByDateDesc(
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.category === category,
  ),
);
---

<BaseLayout title={info.label} description={info.description}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav aria-label="Trilha de navegação" class="text-sm text-gray-500 dark:text-gray-400">
      <ol class="flex flex-wrap items-center gap-1">
        <li>
          <a href="/" class="rounded-lg transition-colors hover:text-pink-700 dark:hover:text-pink-300">Início</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href="/blog" class="rounded-lg transition-colors hover:text-pink-700 dark:hover:text-pink-300">Blog</a>
        </li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="text-gray-700 dark:text-gray-200">{info.label}</li>
      </ol>
    </nav>

    <header class="mt-6 max-w-2xl">
      <h1 class="font-display text-3xl font-bold text-gray-900 sm:text-4xl dark:text-white">{info.label}</h1>
      <p class="mt-3 text-lg leading-relaxed text-gray-600 dark:text-gray-300">{info.description}</p>
    </header>

    <nav aria-label="Outras categorias" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {
          CATEGORY_IDS.map((id) => (
            <li>
              <a
                href={`/categorias/${id}`}
                aria-current={id === category ? "page" : undefined}
                class:list={[
                  "inline-block rounded-full border px-4 py-1.5 text-sm font-medium transition-colors",
                  id === category
                    ? "border-pink-300 bg-pink-100 text-pink-800 dark:border-pink-600 dark:bg-pink-900 dark:text-pink-200"
                    : "border-gray-200 bg-white text-gray-700 hover:border-pink-300 hover:bg-pink-50 hover:text-pink-800 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:border-pink-600 dark:hover:bg-pink-900/40 dark:hover:text-pink-200",
                ]}
              >
                {CATEGORIES[id].label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      posts.length > 0 ? (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} headingLevel="h2" />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-gray-600 dark:text-gray-300">
          Ainda não há posts nesta categoria. Enquanto isso,
          <a href="/blog" class="font-medium text-pink-700 underline underline-offset-2 hover:text-pink-800 dark:text-pink-300 dark:hover:text-pink-200">
            veja todos os posts
          </a>
          .
        </p>
      )
    }
  </div>
</BaseLayout>
