---
import { SIGNUP_URL } from "../consts";

// Short nav labels for the category hubs (full labels live in lib/categories).
const NAV = [
  { href: "/categorias/dividir-contas", label: "Dividir contas" },
  { href: "/categorias/organizacao", label: "Organização" },
  { href: "/categorias/conversas-sobre-dinheiro", label: "Conversas" },
  { href: "/categorias/metas-e-sonhos", label: "Metas" },
  { href: "/categorias/ferramentas", label: "Ferramentas" },
  { href: "/sobre", label: "Sobre" },
];
---

<header class="border-b border-gray-100 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-gray-900/90">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5 rounded-xl" aria-label="Paca Finance — página inicial">
      <img src="/logo-icon-96.png" alt="" class="h-9 w-9 rounded-xl" width="36" height="36" />
      <span class="font-display text-xl font-bold tracking-tight text-gray-800 dark:text-white">paca<span class="text-pink-500 dark:text-pink-300">finance</span></span>
    </a>

    <nav aria-label="Navegação principal" class="order-3 w-full lg:order-none lg:w-auto">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm font-medium">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded py-1 text-gray-700 transition-colors hover:text-pink-700 dark:text-gray-200 dark:hover:text-pink-300"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <button
        type="button"
        data-theme-toggle
        aria-label="Alternar tema claro/escuro"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-gray-200 bg-white text-gray-700 transition-colors hover:border-pink-300 hover:text-pink-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:border-pink-600 dark:hover:text-pink-300"
      >
        {/* moon shown in light mode (click -> dark), sun shown in dark mode */}
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"></path>
        </svg>
      </button>

      <a
        href={SIGNUP_URL}
        class="rounded-xl bg-pink-primary px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm transition-colors hover:bg-pink-400"
      >
        Criar conta grátis
      </a>
    </div>
  </div>
</header>

{/* Tiny inline handler — the only client JS besides the no-flash snippet. */}
<script is:inline>
  document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (_) {
        /* storage unavailable */
      }
    });
  });
</script>
