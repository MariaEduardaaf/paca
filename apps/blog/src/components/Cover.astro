---
/**
 * Capa do artigo no SITE.
 *
 * A palavra gigante aqui é a CATEGORIA, não o título: no site o título já está
 * escrito logo abaixo do card (e no topo do artigo, logo acima), então repetir
 * seria redundante. O título só entra na palavra gigante do card de
 * compartilhamento (scripts/og.mjs), onde a imagem viaja sozinha.
 *
 * O desenho inteiro vive em src/lib/cover-art.mjs + src/styles/cover.css — este
 * componente só resolve o rótulo da categoria e monta o elemento. Nenhuma regra
 * de estilo de capa aqui dentro.
 */
import "../styles/cover.css";
import { CATEGORIES, type CategoryId } from "../lib/categories";
import { coverArt } from "../lib/cover-art.mjs";

interface Props {
  category: CategoryId;
  /** Slug do artigo — define o fundo e o motivo. As páginas de categoria
   *  passam o id da própria categoria. */
  slug: string;
  class?: string;
}

const { category, slug, class: className = "" } = Astro.props;

const { html, style } = coverArt({
  slug,
  category,
  categoryLabel: CATEGORIES[category]?.label ?? category,
  mode: "category",
});
---

{/*
  A capa é DECORATIVA: tudo que ela diz (categoria, título) está em texto de
  verdade ao lado. `aria-hidden` é o que descreve isso corretamente — `role="img"`
  sem nome acessível é justamente o que os validadores apontam.
*/}
<div class:list={["paca-cover", className]} style={style} aria-hidden="true" set:html={html} />
