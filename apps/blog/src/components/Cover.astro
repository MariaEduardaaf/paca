---
import type { CategoryId } from "../lib/categories";
import { COVER_INK, COVER_PALETTES, coverVariant } from "../lib/covers";

interface Props {
  category: CategoryId;
  slug: string;
  class?: string;
}

const { category, slug, class: className = "" } = Astro.props;
const palette = COVER_PALETTES[category];
const variant = coverVariant(slug);

// Motif sits in a 675x675 square anchored to one side, bleeding off the edge.
const motifTransform = [
  variant.mirrored ? "translate(210 90)" : "translate(680 90)",
  `rotate(${variant.rotation} 320 280)`,
].join(" ");

const watermarkY = variant.watermarkTop ? 200 : 640;
const watermarkX = variant.mirrored ? 1180 : 24;
const watermarkAnchor = variant.mirrored ? "end" : "start";
---

<!-- Decorative duotone cover: two category colors + ink watermark. -->
<svg
  class={className}
  viewBox="0 0 1200 675"
  role="img"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid slice"
>
  <rect width="1200" height="675" fill={palette.bg}></rect>

  <text
    x={watermarkX}
    y={watermarkY}
    text-anchor={watermarkAnchor}
    fill={COVER_INK}
    opacity="0.08"
    font-family="'Bricolage Grotesque', system-ui, sans-serif"
    font-weight="800"
    font-size="190"
    letter-spacing="-6"
  >{palette.word}</text>

  <g transform={motifTransform}>
    {category === "dividir-contas" && (
      <>
        {/* Two overlapping rings — the couple; the shared lens is what they split. */}
        <circle cx="220" cy="280" r="190" fill="none" stroke={palette.fg} stroke-width="44" />
        <circle cx="440" cy="280" r="190" fill="none" stroke={palette.fg} stroke-width="44" />
        <path
          d="M 330 122 A 190 190 0 0 1 330 438 A 190 190 0 0 1 330 122 Z"
          fill={palette.fg}
          opacity="0.35"
        />
      </>
    )}
    {category === "organizacao" && (
      <>
        {/* Pie with a pulled slice — the budget taking shape. */}
        <path d="M 300 280 L 300 80 A 200 200 0 1 1 127 380 Z" fill={palette.fg} />
        <path d="M 340 240 L 340 60 A 200 200 0 0 1 513 160 Z" fill={palette.fg} opacity="0.45" />
      </>
    )}
    {category === "conversas-sobre-dinheiro" && (
      <>
        {/* Two speech bubbles mid-conversation. */}
        <path
          d="M 60 120 h 300 a 48 48 0 0 1 48 48 v 120 a 48 48 0 0 1 -48 48 h -180 l -72 76 v -76 h -48 a 48 48 0 0 1 -48 -48 v -120 a 48 48 0 0 1 48 -48 Z"
          fill={palette.fg}
        />
        <path
          d="M 280 300 h 280 a 44 44 0 0 1 44 44 v 104 a 44 44 0 0 1 -44 44 h -44 v 68 l -66 -68 h -170 a 44 44 0 0 1 -44 -44 v -104 a 44 44 0 0 1 44 -44 Z"
          fill={palette.fg}
          opacity="0.45"
        />
      </>
    )}
    {category === "metas-e-sonhos" && (
      <>
        {/* Concentric target — the goal the couple is aiming at. */}
        <circle cx="320" cy="290" r="210" fill="none" stroke={palette.fg} stroke-width="36" opacity="0.4" />
        <circle cx="320" cy="290" r="130" fill="none" stroke={palette.fg} stroke-width="36" opacity="0.7" />
        <circle cx="320" cy="290" r="52" fill={palette.fg} />
      </>
    )}
    {category === "ferramentas" && (
      <>
        {/* Spreadsheet cells — one already filled in. */}
        <rect x="80" y="90" width="180" height="180" rx="36" fill="none" stroke={palette.fg} stroke-width="26" />
        <rect x="320" y="90" width="180" height="180" rx="36" fill="none" stroke={palette.fg} stroke-width="26" />
        <rect x="80" y="330" width="180" height="180" rx="36" fill="none" stroke={palette.fg} stroke-width="26" />
        <rect x="320" y="330" width="180" height="180" rx="36" fill={palette.fg} />
      </>
    )}
  </g>
</svg>
