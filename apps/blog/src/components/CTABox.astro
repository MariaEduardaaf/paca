---
import { APP_URL, APP_STORE_URL, PLAY_STORE_URL } from "../consts";

interface Props {
  title?: string;
  body?: string;
  buttonLabel?: string;
}

const {
  title = "Chega de planilha",
  body = "O Paca organiza o dinheiro do casal num app só: gastos compartilhados em tempo real, contas divididas do jeito justo e metas a dois.",
  buttonLabel = "Conhecer o Paca Finance",
} = Astro.props;
---

<aside
  aria-label="Conheça o Paca Finance"
  class="my-10 rounded-3xl bg-gradient-to-br from-pink-50 via-pink-100 to-pink-200 p-6 sm:p-8 dark:from-gray-800 dark:via-gray-800 dark:to-pink-900/40 dark:ring-1 dark:ring-pink-800"
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-md">
      <p class="font-display text-xl font-bold text-gray-900 dark:text-white">{title}</p>
      <p class="mt-2 text-sm leading-relaxed text-gray-700 dark:text-gray-200">{body}</p>
    </div>
    <div class="flex flex-col items-start gap-3">
      <a
        href={APP_URL}
        class="inline-block rounded-xl bg-pink-primary px-5 py-3 text-sm font-semibold text-gray-900 shadow-sm transition-colors hover:bg-pink-400"
      >
        {buttonLabel}
      </a>
      {/* Store badges appear only when the URLs are filled in src/consts.ts */}
      {
        (APP_STORE_URL || PLAY_STORE_URL) && (
          <div class="flex gap-3 text-sm font-medium">
            {APP_STORE_URL && (
              <a href={APP_STORE_URL} class="rounded-lg text-pink-700 underline underline-offset-2 hover:text-pink-800 dark:text-pink-300 dark:hover:text-pink-200">
                App Store
              </a>
            )}
            {PLAY_STORE_URL && (
              <a href={PLAY_STORE_URL} class="rounded-lg text-pink-700 underline underline-offset-2 hover:text-pink-800 dark:text-pink-300 dark:hover:text-pink-200">
                Google Play
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</aside>
